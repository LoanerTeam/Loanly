MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=loanly
# Required with DEV_AUTH=0: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_API_KEY=
# Gemini text model for summarize and translate; change it if Google retires this one.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini request limits per minute (RPM) and per day (RPD), shared by all users.
# Set them to the free-tier values shown at https://aistudio.google.com/rate-limit
AI_TEXT_RPM=10
AI_TEXT_RPD=500
AI_STT_RPM=3
AI_STT_RPD=100
AI_TTS_RPM=3
AI_TTS_RPD=15
# Local development only: token is just a username. Server refuses to start if set together with RENDER.
DEV_AUTH=0
